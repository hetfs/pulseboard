# ----------------------------------------
# ⚙️ Core Git Attributes
# ----------------------------------------

# Normalize all text files to LF line endings
* text=auto eol=lf

# ----------------------------------------
# 🧩 Python and Code Files
# ----------------------------------------
*.py        text diff=python
*.pyi       text diff=python
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf
*.rst       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf

# ----------------------------------------
# 🧪 Test and Data Files
# ----------------------------------------
*.csv       text eol=lf
*.tsv       text eol=lf
*.jsonl     text eol=lf
*.ipynb     text eol=lf

# ----------------------------------------
# 📦 Build and Binary Artifacts
# ----------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.svg       text
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.tar.gz    binary
*.pkl       binary
*.db        binary
*.sqlite3   binary

# ----------------------------------------
# 🧰 Git and CI Tools
# ----------------------------------------
*.diff      text
*.patch     text
*.log       text
*.lock      text
*.env       text
*.example   text
.pre-commit-config.yaml text eol=lf

# ----------------------------------------
# 🧑‍💻 Documentation
# ----------------------------------------
docs/**     text eol=lf
*.md        text diff=markdown

# ----------------------------------------
# 🚀 Project-Specific Settings
# ----------------------------------------
scripts/**  text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf

# ----------------------------------------
# 🔒 Ensure consistent GitHub rendering
# ----------------------------------------
.gitattributes text eol=lf
.gitignore     text eol=lf
